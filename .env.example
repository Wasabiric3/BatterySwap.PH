# ============================================================
# BatterySwap PH — Environment Variables
# Copy this file to .env.local (frontend) or .env (backend)
# NEVER commit actual secrets to git
# ============================================================

# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/batteryswap?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/batteryswap"   # for Supabase pooling

# ─── Auth (NextAuth.js) ───────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ─── SMS OTP (Semaphore PH) ──────────────────────────────────
SEMAPHORE_API_KEY="your-semaphore-api-key"
SEMAPHORE_SENDER_NAME="BATTERYSWAP"

# ─── Google Maps ─────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Payments (PayMongo) ─────────────────────────────────────
PAYMONGO_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxx"
PAYMONGO_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxx"
PAYMONGO_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxx"

# ─── Firebase (Push Notifications) ──────────────────────────
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@project.iam.gserviceaccount.com"
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_APP_ID="1:xxxxxx:web:xxxxxx"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="xxxxxxxx"

# ─── File Storage (Cloudflare R2 / S3) ──────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="batteryswap-assets"
R2_PUBLIC_URL="https://assets.batteryswap.ph"

# ─── Error Tracking (Sentry) ─────────────────────────────────
SENTRY_DSN="https://xxxxx@sentry.io/xxxxxx"
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@sentry.io/xxxxxx"

# ─── App Config ───────────────────────────────────────────────
NODE_ENV="development"
API_BASE_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
APP_URL="http://localhost:3000"

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET="generate-with: openssl rand -base64 64"
JWT_REFRESH_SECRET="generate-with: openssl rand -base64 64"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
