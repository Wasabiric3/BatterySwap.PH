# Copy this file to `.env.local` for local development and fill values.
# Do NOT commit `.env.local` with secrets.

# Playwright (E2E) base URL — useful for CI or remote test targets
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Public API base used by client-side code (if applicable)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Google Maps JavaScript API key (if your map components require it)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# NextAuth (if used)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_this_to_a_secure_value

# Analytics / Monitoring
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=

# Payment providers (placeholders)
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
NEXT_PUBLIC_GCASH_CLIENT_ID=

# Feature flags
NEXT_PUBLIC_ENABLE_DIAGNOSTICS=true
